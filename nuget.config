<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      GitHub Packages NuGet : packages internes Popforge.
      Localement : définir la variable d'environnement NUGET_AUTHTOKEN avec un PAT GitHub (read:packages).
      En CI    : GITHUB_TOKEN est injecté automatiquement par le workflow.
    -->
    <add key="popforge-nuget" value="https://nuget.pkg.github.com/popforge/index.json" />
    <!-- Feed local : pointe vers Popforge.Shared/local-nuget pour le dev sans publication -->
    <add key="popforge-local" value="..\Popforge.Shared\local-nuget" />
  </packageSources>
  <packageSourceCredentials>
    <popforge-nuget>
      <add key="Username" value="popforge" />
      <add key="ClearTextPassword" value="%NUGET_AUTHTOKEN%" />
    </popforge-nuget>
  </packageSourceCredentials>
</configuration>
