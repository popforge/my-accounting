#!/bin/sh
# pre-push
# Workflow perso uniquement:
# - user.email local doit etre l'email noreply attendu
# - tous les commits pushes doivent avoir le meme author email
#
# Installation automatique : scripts/setup-repo.ps1

set -eu

EXPECTED_EMAIL=$(git config --get hooks.expectedEmail || true)
CURRENT_EMAIL=$(git config user.email || true)

if [ -z "$EXPECTED_EMAIL" ]; then
  printf "\n  !! ERREUR pre-push: hooks.expectedEmail absent.\n"
  printf "  Relance scripts/setup-repo.ps1 pour reinitialiser le depot.\n\n"
  exit 1
fi

if [ "$CURRENT_EMAIL" != "$EXPECTED_EMAIL" ]; then
  printf "\n  !! ERREUR pre-push: mauvais user.email local.\n\n"
  printf "     Actuel  : %s\n" "$CURRENT_EMAIL"
  printf "     Attendu : %s\n\n" "$EXPECTED_EMAIL"
  printf "  Corrige avec:\n"
  printf "    git config user.email \"%s\"\n" "$EXPECTED_EMAIL"
  exit 1
fi

# stdin: local_ref local_sha remote_ref remote_sha
while read -r local_ref local_sha remote_ref remote_sha
do
  # Suppression de branche distante: rien a verifier.
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  bad_emails=$(git log --format='%ae' "$range" | sort -u | grep -v "^$EXPECTED_EMAIL$" || true)
  if [ -n "$bad_emails" ]; then
    printf "\n  !! ERREUR pre-push: commits avec un author email non conforme.\n\n"
    printf "  Attendu: %s\n" "$EXPECTED_EMAIL"
    printf "  Trouves:\n%s\n\n" "$bad_emails"
    printf "  Corrige (exemple, dernier commit):\n"
    printf "    git commit --amend --reset-author --no-edit\n\n"
    exit 1
  fi
done

exit 0
