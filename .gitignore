# package-lock.json est intentionnellement tracké (builds reproductibles)
# Si une règle parent venait à l'ignorer, décommenter :
# !package-lock.json

# Artefacts .js émis par tsc/vue-tsc dans le dossier source (ne devrait pas arriver
# si outDir est configuré correctement dans tsconfig.app.json, mais ignorés par sécurité)
src/**/*.js
src/**/*.vue.js