# Copier vers deploy.env en dehors du git et remplacer les valeurs.
# Ce fichier est un exemple — deploy.env est gitignore.

# Tag de l'image API à déployer
MY_ACCOUNTING_API_TAG=v1.0.0

# Tag de l'image SPA à déployer
MY_ACCOUNTING_APP_TAG=v1.0.0

# Liaison réseau (127.0.0.1 = accessible uniquement via nginx)
MY_ACCOUNTING_HOST_BIND=127.0.0.1
MY_ACCOUNTING_API_PORT=8095
MY_ACCOUNTING_APP_PORT=8096

# Environnement ASP.NET Core
MY_ACCOUNTING_ASPNETCORE_ENVIRONMENT=Beta

# Chaîne de connexion Neon PostgreSQL (cluster my-accounting)
MY_ACCOUNTING_DB_CONNECTION=Host=ep-example-pooler.c-5.us-east-1.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=<password>;SSL Mode=Require;Trust Server Certificate=true

# URL du serveur OIDC (Popforge.Auth)
MY_ACCOUNTING_OIDC_AUTHORITY=https://auth-beta.popsalon.app

# CORS — origines autorisées (séparées par virgule)
MY_ACCOUNTING_ALLOWED_ORIGINS=https://my-accounting-beta.popsalon.app
